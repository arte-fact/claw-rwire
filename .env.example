# claw-rwire configuration. Copy to `.env` and fill in. `.env` is gitignored;
# real environment variables always take precedence over `.env`.

# --- LLM endpoint (OpenAI-compatible /chat/completions) ---
# On first boot with an empty `endpoints` table, these seed a "default" endpoint
# and agent group in the DB. Leave unset to keep the built-in echo agent.
# Works with OpenAI, OpenRouter, llama.cpp, vLLM, Ollama, … (same protocol).
CLAW_ENDPOINT=https://api.openai.com/v1
CLAW_MODEL=gpt-4o-mini
# Optional. Bearer token; omit for keyless local servers (llama.cpp, Ollama).
CLAW_API_KEY=

# --- Server ---
# CLAW_BIND=0.0.0.0:8080
# CLAW_DATA_DIR=./claw-data

# --- Auth (form login) ---
# CLAW_AUTH_USER=claw
# Set a token to fix the password; otherwise one is generated and printed at startup.
# CLAW_AUTH_TOKEN=
